rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Test
    match /test/connection {
      allow read: if true;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'andikatrikurniawan199@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
               data.keys().size() == 4 &&
               data.id == request.auth.uid &&
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               data.role in ['customer', 'admin'];
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == 'customer';
      
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == existing().role && // Role immutable by user
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']);
    }

    // 2. Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['customerId', 'customerName', 'whatsapp', 'shoeType', 'serviceId', 'totalPrice', 'status']) &&
               data.customerId == request.auth.uid &&
               data.customerName is string && data.customerName.size() <= 100 &&
               data.whatsapp is string && data.whatsapp.size() <= 20 &&
               data.totalPrice is number && data.totalPrice >= 0 &&
               data.status in ['pending', 'confirmed', 'picked_up', 'washing', 'drying', 'finishing', 'shipping', 'completed', 'cancelled'];
      }

      allow get: if isSignedIn() && (isOwner(existing().customerId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                      isValidOrder(incoming()) && 
                      incoming().status == 'pending';
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(existing().customerId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentProofUrl', 'notes']) &&
         (incoming().status == 'cancelled' && existing().status == 'pending'))
      );

      allow delete: if isAdmin();
    }

    // 4. Admins Collection (Restricted)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
